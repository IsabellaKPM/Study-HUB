{
  "name": "study-hub",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "author": "IsabellaKPM",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "commit": "cz",
    "prepare": "husky",
    "tauri": "tauri",
    "start:dev": "tauri dev",
    "start:fe": "vite",
    "start:preview": "vite preview",
    "build": "tsc && vite build",
    "build:tauri": "tauri build",
    "typecheck:fe": "tsc --noEmit",
    "typecheck": "pnpm run typecheck:fe",
    "format:fe": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:fe:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\"",
    "format:be": "cd src-tauri && cargo fmt",
    "format:be:check": "cd src-tauri && cargo fmt --check",
    "format": "pnpm run format:fe && pnpm run format:be",
    "format:check": "pnpm run format:fe:check && pnpm run format:be:check",
    "lint:fe": "eslint .",
    "lint:fe:fix": "eslint . --fix",
    "lint:be": "cd src-tauri && cargo clippy -- -D warnings",
    "lint": "pnpm run lint:fe && pnpm run lint:be",
    "lint:fix": "pnpm run lint:fe:fix && pnpm run format:be",
    "test:fe": "echo \"No FE tests configured yet\"",
    "test:be": "cd src-tauri && cargo test",
    "test": "pnpm run test:be",
    "ci:fe": "pnpm run typecheck:fe && pnpm run lint:fe && pnpm run format:fe:check",
    "ci:be": "pnpm run format:be:check && pnpm run lint:be && pnpm run test:be",
    "ci:check": "pnpm run typecheck && pnpm run lint && pnpm run format:check",
    "ci": "pnpm run ci:check && pnpm run test"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ],
    "src-tauri/**/*.rs": [
      "rustfmt --edition 2021"
    ]
  },
  "config": {
    "commitizen": {
      "path": "@commitlint/cz-commitlint"
    }
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hookform/resolvers": "^5.7.1",
    "@tanstack/react-query": "^5.101.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.29.0",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.85.0",
    "react-router-dom": "^7.18.2",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.1.2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^5.2.0",
    "commitizen": "^4.3.2",
    "conventional-changelog-conventionalcommits": "^10.2.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.66.0",
    "vite": "^7.0.4",
    "vite-tsconfig-paths": "^6.1.1"
  },
  "packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1"
}
